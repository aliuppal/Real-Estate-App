# ── Auth.js ────────────────────────────────────────────────────────────────
# Required. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Needed behind a proxy / in production so Auth.js trusts the host header.
AUTH_TRUST_HOST=true

# Optional. Google sign-in is shown only when both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Data layer ─────────────────────────────────────────────────────────────
# Leave empty to run on the in-memory mock data (default).
# Set to a Neon Postgres connection string to switch to the database (Phase 3).
DATABASE_URL=

# ── App ────────────────────────────────────────────────────────────────────
# Public base URL, used for links in emails and Open Graph tags.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Show the "Demo accounts" card on /login. Set to "false" in production.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
